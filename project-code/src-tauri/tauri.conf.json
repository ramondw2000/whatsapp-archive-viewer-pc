{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Archive Viewer (PC)",
  "version": "1.1.2",
  "identifier": "com.ramon.whatsapp-archive-viewer-pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhatsApp Archive Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/WhatsAppArchiveViewer/chats/**",
          "$APPDATA/WhatsAppArchiveViewer/custom/**",
          "$APPDATA/WhatsAppArchiveViewer/profile_photos/**",
          "$APPDATA/WhatsAppArchiveViewer/user_backgrounds/**",
          "$RESOURCE/app_backgrounds/**"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost http://asset.localhost blob: media: http://media.localhost https://media.localhost; media-src 'self' data: asset: https://asset.localhost http://asset.localhost blob: media: http://media.localhost https://media.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: https://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "resources": ["vc_redist.x64.exe", "resources/app_backgrounds"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  }
}